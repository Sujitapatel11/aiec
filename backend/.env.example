SECRET_KEY=your-strong-secret-key-here

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DATABASE_URL=your-neon-postgres-url-here
OPENAI_API_KEY=sk-your-openai-key
WHATSAPP_NUMBER=9802020575
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Email (Gmail SMTP — use an App Password, not your regular Gmail password)
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
NOTIFY_EMAIL=admin-notify@yourdomain.com

# Password Reset
# Frontend base URL — used to build the reset link sent in the email
FRONTEND_URL=https://yourdomain.com
# How long reset tokens are valid (seconds). Default: 3600 = 1 hour
PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Set to "console" for local development — prints email to stdout instead of sending
# Leave unset or blank for production SMTP
EMAIL_BACKEND_OVERRIDE=

# ── Twilio WhatsApp (Phase A — Outbound Lead Messaging) ──────────────────
# Obtain from: https://console.twilio.com
# TWILIO_ACCOUNT_SID : Your Twilio Account SID (starts with AC...)
# TWILIO_AUTH_TOKEN  : Your Twilio Auth Token (keep SECRET — never commit)
# TWILIO_WHATSAPP_FROM : Your AIEC registered WhatsApp Business sender
#                        Format: whatsapp:+<E.164>  e.g. whatsapp:+9779XXXXXXXXX
#                        Do NOT use the Twilio sandbox number (whatsapp:+14155238886)
#                        for production Lead messaging — the backend will reject it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
